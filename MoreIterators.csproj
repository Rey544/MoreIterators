<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Uses the existing .NET Framework compiler and locally installed game
       references. No game assemblies are copied to this project's output. -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <AssemblyName>MoreIterators</AssemblyName>
    <RootNamespace>MoreIterators</RootNamespace>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <GameRoot Condition="'$(GameRoot)' == ''">$(RAIN_WORLD_ROOT)</GameRoot>
    <OutputPath Condition="'$(OutputPath)' == ''">bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath Condition="'$(IntermediateOutputPath)' == ''">obj\$(Configuration)\</IntermediateOutputPath>
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <WarningLevel>4</WarningLevel>
    <DefineConstants>TRACE</DefineConstants>
    <ManagedRoot>$(GameRoot)\RainWorld_Data\Managed</ManagedRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="localization\game\*.json">
      <LogicalName>mi.ui.%(Filename).json</LogicalName>
    </EmbeddedResource>
    <Reference Include="mscorlib"><HintPath>$(MSBuildToolsPath)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><Private>false</Private></Reference>
    <Reference Include="System.Core"><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedRoot)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ManagedRoot)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedRoot)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(ManagedRoot)\Unity.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedRoot)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedRoot)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(ManagedRoot)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedRoot)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(ManagedRoot)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule"><HintPath>$(ManagedRoot)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedRoot)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedRoot)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedRoot)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(GameRoot)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HOOKS-Assembly-CSharp"><HintPath>$(GameRoot)\BepInEx\plugins\HOOKS-Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoMod.Utils"><HintPath>$(GameRoot)\BepInEx\core\MonoMod.Utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(GameRoot)\BepInEx\core\MonoMod.RuntimeDetour.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(GameRoot)\BepInEx\core\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="BeforeBuild">
    <Error Condition="'$(GameRoot)' == ''" Text="Set the GameRoot MSBuild property or RAIN_WORLD_ROOT environment variable to your Rain World installation." />
    <Error Condition="!Exists('$(ManagedRoot)\Assembly-CSharp.dll')" Text="The configured GameRoot does not contain RainWorld_Data/Managed/Assembly-CSharp.dll." />
    <Error Condition="!Exists('localization\game\en.json') Or !Exists('localization\game\zh-CN.json')" Text="Both game UI translation resources are required." />
  </Target>
</Project>
